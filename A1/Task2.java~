import java.util.Scanner;
public class Task2{
  public static void main(String[]args){
    Scanner sc= new Scanner(System.in);
    int T= sc.nextInt();
    
    for(int i=0;i<T;i++){
      String st=sc.nextString();
      int N= sc.nextInt();
      String op=sc.nextString();
     int M= sc.nextInt();
     if(op.equals("+")){
      System.out.println(N+M);
     }
     if(op.equals("-")){
       System.out.println(N-M);
     }
     if(op.equals("*")){
      System.out.println(N*M);
     }
      if(op.equals("/")){
      System.out.println(N/M);
     }
      if(op.equals("%")){
      System.out.println(N%M);
     }
      if(op.equals("&")){
      System.out.println(N&M);
     }
      if(op.equals("|")){
      System.out.println(N|M);
     }
      if(op.equals("^")){
      System.out.println(N^M);
     }
      if(op.equals("<<")){
      System.out.println(N<<M);
     }
      if(op.equals(">>")){
      System.out.println(N>>M);
     }
    }
  }
}
      
     